# Environment / Runtime Configuration
# Do not store version-controlled reconciliation constants here.

# Storage
DATABASE_PATH=sqlite:///./eagle.db
CHROMADB_PATH=./chroma_data

# AI Provider — Generic Selection (Reconciliation & Exception Classification)
AI_PROVIDER=llama_server
AI_MODEL=gemma-4-E4B-it-Q4_K_M.gguf
LLAMA_SERVER_URL=http://127.0.0.1:8080

# Vision Provider — Image & Scanned Document Extraction (Independent from AI_PROVIDER)
VISION_PROVIDER=llama_server
VISION_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
VISION_TIMEOUT_SECONDS=60

# Provider-Specific Credentials
GEMINI_API_KEY=
CLAUDE_API_KEY=

# Classifier Configuration
AI_MAX_RETRIES=1
AI_TIMEOUT_SECONDS=120
AI_MAX_CONCURRENCY=1
